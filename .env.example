# Firebase — Existing project CorexIT (corexit-652f5) — Web App: corexit
# Do NOT create a new Firebase project. Copy these keys to .env.local (not committed).
# Client (public) — NEXT_PUBLIC_* are safe to expose to browser
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_DATABASE_URL=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=corexit-652f5
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# ── Server-only Firebase Admin SDK — NEVER use NEXT_PUBLIC_*, NEVER commit real values ──
# Option A: Full service account JSON as a single env var (recommended on Vercel)
# Paste the entire JSON file content as a single line, or base64-encode it.
# Get it from: Firebase Console → Project Settings → Service Accounts → Generate New Private Key (corexit-652f5)
# Example (placeholder only):
# FIREBASE_SERVICE_ACCOUNT_KEY={"type":"service_account","project_id":"corexit-652f5", ...}
FIREBASE_SERVICE_ACCOUNT_KEY=

# Option B: Split private key + client email (alternative if JSON env is unwieldy)
# Private key must keep \n line breaks (paste as-is with \n, file will convert \\n → \n)
FIREBASE_ADMIN_PRIVATE_KEY=
FIREBASE_ADMIN_CLIENT_EMAIL=
# Optional — defaults to corexit-652f5 if omitted (keep as corexit-652f5)
FIREBASE_ADMIN_PROJECT_ID=corexit-652f5
